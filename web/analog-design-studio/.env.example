# Phase 4 — local Cadence execution bridge
# Keep this bridge disabled unless the Next.js server runs on a trusted local machine.
CADENCE_BRIDGE_ENABLED=false

# Linux VM / host reachable over SSH
CADENCE_SSH_HOST=<vm-host-or-ip>
CADENCE_SSH_USER=cadence

# Writable staging directory on the Linux Cadence environment
CADENCE_REMOTE_WORKDIR=/home/cadence/Desktop/analog-design-studio-runs

# Verified IC6.1.7 executable path for the supplied environment
CADENCE_VIRTUOSO_PATH=/usr/local/cadence/IC617/tools/dfII/bin/virtuoso

# Maximum Virtuoso execution time in milliseconds
CADENCE_TIMEOUT_MS=180000

# Optional local SSH private key path
# CADENCE_SSH_KEY=C:/Users/<user>/.ssh/id_ed25519
